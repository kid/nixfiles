(deflisten hyprland "./scripts/hyprland.sh")

(include "./modules/clock.yuck")
(include "./modules/layout.yuck")
(include "./modules/workspaces.yuck")

(defwidget left []
  (box
    :space-evenly false
    :halign "start"
    (workspaces)
    (layout)))

(defwidget center []
  (box
    :space-evenly false
    :halign "start"))

(defwidget right []
  (box
    :space-evenly false
    :halign "end"
    (clock)))

(defwidget bar []
  (centerbox
    (left)
    (center)
    (right)))

(defwindow bar
  :monitor 0
  :geometry (geometry 
    :x "0"
    :y "0"
    :width "100%"
    :height "32px"
    :anchor "top center")
  :stack "fg"
  :exclusive true
  (bar))
