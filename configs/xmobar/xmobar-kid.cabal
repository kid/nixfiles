cabal-version: 2.4
name:          xmobar-kid
version:       0.1.0.0
category:      System
build-type:    Simple


executable xmobar-kid
  main-is:          xmobar.hs
  build-depends:
      base
    , xmobar

  ghc-options: -rtsopts -threaded -with-rtsopts=-N -Wall
  hs-source-dirs:   .
  default-language: Haskell2010
