// Base config is inherited from kid/renovate-config, which also runs Renovate.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customDatasources: {
    // Build list of the ksa-archive.net mirror that
    // pkgs/by-name/kitten-space-agency fetches from. Only builds named
    // ksa_linux_v<version>.tar.gz match the package's URL template; older
    // Linux builds used other names.
    "kitten-space-agency": {
      defaultRegistryUrlTemplate: "https://ksa-archive.net/builds.json",
      transformTemplates: [
        '{"releases": $[$contains(linuxFile, /^ksa_linux_v[0-9.]+\\.tar\\.gz$/)].{"version": $match(linuxFile, /v([0-9.]+)\\.tar\\.gz$/).groups[0], "releaseTimestamp": date}}',
      ],
    },
  },
  customManagers: [
    // Flake inputs pinned by rev in the flake-file module that declares
    // them (modules/**) get their own PR. The nix manager would edit the
    // generated flake.nix instead, which flake-file reports as drift.
    {
      customType: "regex",
      managerFilePatterns: ["/^modules/.+\\.nix$/"],
      matchStrings: [
        '"github:(?<depName>[^/"]+/[^/"]+)/(?<currentDigest>[0-9a-f]{40})"',
      ],
      datasourceTemplate: "git-refs",
      packageNameTemplate: "https://github.com/{{{depName}}}",
    },
  ],
  packageRules: [
    {
      // Inputs not pinned by rev keep moving in the weekly lockFileMaintenance PR.
      matchManagers: ["nix"],
      matchUpdateTypes: [
        "major",
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest",
        "bump",
      ],
      enabled: false,
    },
    {
      // flake.nix and flake.lock are regenerated from the bumped module.
      matchManagers: ["custom.regex"],
      matchDatasources: ["git-refs"],
      postUpgradeTasks: {
        commands: ["nix run .#write-flake", "nix flake lock"],
        fileFilters: ["flake.nix", "flake.lock"],
        executionMode: "update",
      },
    },
  ],
}
